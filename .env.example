# =================================================================
# HONEY CHAIN — ENVIRONMENT CONFIGURATION (.env.example)
# =================================================================

# 1. SERVER & PORT
# The port where the full-stack Node.js / Express server binds.
# Default: 3000 (Required by AI Studio iframe environment).
PORT=3000

# 2. GOOGLE GEMINI AI (Server-Side)
# Required for:
# - Madhubot (द्विभाषी AI Bee Assistant in English and Hindi)
# - Executive Supply Chain AI Insights Panel (anomalies, regional yield forecasts)
# - Honeycomb brood disease visual diagnosis and smart grouping
# Key format: Alphanumeric string from Google AI Studio.
GEMINI_API_KEY=

# 3. FIREBASE CLIENT CONFIGURATION
# Connected project credentials (referenced in firebase-applet-config.json).
# Format: AIzaSy... (39-character alphanumeric string from Firebase Console Settings).
FIREBASE_API_KEY=

# 4. RAZORPAY TEST GATEWAY (Phase 4 Marketplace & Checkout)
# Used for HMAC-SHA256 signature authorization and checkout.
# NOTE: If you do not have live Razorpay keys, leave these safe placeholder defaults.
# The application automatically runs in graceful simulated test order mode and will never crash.
# Format: Starts with "rzp_test_..." or placeholder string.
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder_secret

# 5. POLYGON AMOY TESTNET / WEB3 (Optional)
# If provided, hashes and batch provenance are anchored to Polygon Amoy PoS testnet.
# If omitted, the internal SHA-256 cryptographic hash-chained ledger engine is used seamlessly.
VITE_POLYGON_RPC_URL=https://rpc-amoy.polygon.technology/
VITE_CONTRACT_ADDRESS=
